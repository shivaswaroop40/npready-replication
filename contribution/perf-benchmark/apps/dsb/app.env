# perfbench app bundle: DeathStarBench socialNetwork @6ecb097 (thesis run results/DSB-SOCIAL-20260904).
# Plain KEY=value lines, safe to `source` from bash. tools/prepare.py reads this file too.
APP=dsb
APP_NS=dsb

# Journey A = shipped read-home-timeline.lua under wrk2, -t 2 -c 8 -R 20, exponential
# arrivals (workloads/wrk2-A.yaml). One continuous run of STEADY_SECONDS (see NOTES.md).
STEADY_KIND=wrk2
STEADY_JOB=pb-steady
STEADY_IMAGE=deathstarbench/wrk2-client:latest
STEADY_WRK2_ARGS="-D exp -t 2 -c 8 -L -s /scripts/read-home-timeline.lua"
STEADY_URL=http://nginx-thrift.dsb.svc.cluster.local:8080/wrk2-api/home-timeline/read
STEADY_RATE=20

# Fixed-count test: home-timeline read of user 1 through nginx-thrift (the journey A
# endpoint). nginx-thrift -> home-timeline-service -> home-timeline-redis and
# post-storage-service -> post-storage-memcached/-mongodb. GET, no login, 200.
TP_JOB=pb-tp
TP_URL='http://nginx-thrift:8080/wrk2-api/home-timeline/read?user_id=1&start=0&stop=10'
TP_HEADERS=
TP_EXPECT_STATUS=200
TP_PRE_HOOK=

# deploy.sh builds the socfb-Reed98 social graph once (init.sh). restart.sh restarts only the
# stateless services and keeps the datastores, so the graph survives between runs; init.sh then
# re-runs only if a datastore pod was replaced or restarted (it checks pod uid + restart count).
READY_TIMEOUT=900
INIT_TIMEOUT=3600

# Harness budget (run_matrix.sh): RUN_TIMEOUT is the per-run watchdog in seconds for a full run;
# EST_RUN_S is the expected full-run time used for STATUS.json before the first run finishes.
# A full run needs about 69 min (v2 validation); the watchdog leaves room for one graph rebuild (about 30 min).
RUN_TIMEOUT=7200
EST_RUN_S=4130

# Interleaved cycles (run_matrix.sh --cycles K, run_one.sh --profile cycle): one fixed-count test
# per mode of TP_N_CYCLE requests, sized for about 30-60 s a test at the measured c16 rate.
# Basis: 23.3-27.9 req/s (v2 pilot, 2000 requests at c16) -> 1504 requests = 54-65 s.
# TP_N_CYCLE must be a multiple of TP_C (16): hey sends N/C requests per worker (1500 would send 1488).
TP_N_CYCLE=1504
# A cycle run: ~174 s switch/restart/misc + 60 s idle + 60 s warm-up + 300 s window + 2 tests
# (+ 26 s overhead each). RUN_TIMEOUT_CYCLE is its watchdog (run_matrix default 2400 s).
EST_RUN_S_CYCLE=770
# dsb: 4200 s leaves room for one social-graph rebuild (about 30 min) inside a cycle run.
RUN_TIMEOUT_CYCLE=4200
