# perfbench app bundle: OpenTelemetry demo 1.12.0 manifest, images 1.11.1 (thesis run results/OTEL-20260906).
# Plain KEY=value lines, safe to `source` from bash. tools/prepare.py reads this file too.
APP=otel
APP_NS=otel

# Journey A = browse locustfile (workloads/locustfile_A.py), locust 2.31.5, -u 8 -r 2.
STEADY_KIND=locust
STEADY_JOB=pb-steady
STEADY_IMAGE=locustio/locust:2.31.5
STEADY_LOCUSTFILE=/mnt/locustfile.py
STEADY_HOST=http://opentelemetry-demo-frontend:8080
STEADY_USERS=8
STEADY_RATE=2

# Fixed-count test: recommendations for one product, prices in EUR. frontend ->
# recommendationservice (-> productcatalogservice, flagd), then 4x productcatalogservice
# GetProduct and 4x currencyservice Convert. GET, no login, 200.
TP_JOB=pb-tp
TP_URL='http://opentelemetry-demo-frontend:8080/api/recommendations?productIds=0PUK6V6EV0&currencyCode=EUR'
TP_HEADERS=
TP_EXPECT_STATUS=200
TP_PRE_HOOK=

READY_TIMEOUT=900

# Harness budget (run_matrix.sh): RUN_TIMEOUT is the per-run watchdog in seconds for a full run;
# EST_RUN_S is the expected full-run time used for STATUS.json before the first run finishes.
RUN_TIMEOUT=5400
EST_RUN_S=2870

# Interleaved cycles (run_matrix.sh --cycles K, run_one.sh --profile cycle): one fixed-count test
# per mode of TP_N_CYCLE requests, sized for about 30-60 s a test at the measured c16 rate.
# Precheck 2026-10-03 (play 6ac09d76, baseline, c16): 140.8 req/s -> 7040 (about 50 s).
# Basis: no c16 run yet; smoke test at c8 (200 requests) 99.5 keep-alive / 77.8 new conn req/s, x0.7 for c16 = 54-70 req/s (plan_assumptions.json) -> 4000 requests = 40-51 s at the smoke rates, 57-74 s at the assumed ones. Check after the first cycle.
TP_N_CYCLE=7040
# A cycle run: ~174 s switch/restart/misc + 60 s idle + 60 s warm-up + 300 s window + 2 tests
# (+ 26 s overhead each). RUN_TIMEOUT_CYCLE is its watchdog (run_matrix default 2400 s).
EST_RUN_S_CYCLE=800
RUN_TIMEOUT_CYCLE=2400
