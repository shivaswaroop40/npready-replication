# perfbench app bundle: Online Boutique v0.10.6 (thesis run results/BOUTIQUE-20260903).
# Plain KEY=value lines, safe to `source` from bash. tools/prepare.py reads this file too.
APP=boutique
APP_NS=boutique

# Journey A = Google's shipped Locust generator, unchanged (image entrypoint, USERS=10, RATE=1).
STEADY_KIND=locust
STEADY_JOB=pb-steady
STEADY_IMAGE=us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo/loadgenerator:v0.10.6
STEADY_LOCUSTFILE=/loadgen/locustfile.py
STEADY_HOST=http://frontend:80
STEADY_USERS=10
STEADY_RATE=1

# Fixed-count test: product page. frontend fans out to productcatalog, currency, cart,
# recommendation (-> productcatalog) and ad. GET, no login, 200.
TP_JOB=pb-tp
TP_URL=http://frontend:80/product/OLJCESPC7Z
TP_HEADERS=
TP_EXPECT_STATUS=200
TP_PRE_HOOK=

READY_TIMEOUT=600

# Harness budget (run_matrix.sh): RUN_TIMEOUT is the per-run watchdog in seconds for a full run;
# EST_RUN_S is the expected full-run time used for STATUS.json before the first run finishes.
RUN_TIMEOUT=5400
EST_RUN_S=3120

# Interleaved cycles (run_matrix.sh --cycles K, run_one.sh --profile cycle): one fixed-count test
# per mode of TP_N_CYCLE requests, sized for about 30-60 s a test at the measured c16 rate.
# Basis: 41.6-45.8 req/s (v2 pilot, 2000 requests) and 49-143 req/s, median 67-68 (full matrix 2026-10-02/03, 10000 requests; the spread is host drift) -> 3008 requests = 45 s at the median, 21-72 s over the whole range.
# TP_N_CYCLE must be a multiple of TP_C (16): hey sends N/C requests per worker, so 3000 sent 2992
# and the analysis rejected every test (validation play 6ac0684da347f7b916c94378, 2026-10-03).
TP_N_CYCLE=3008
# A cycle run: ~174 s switch/restart/misc + 60 s idle + 60 s warm-up + 300 s window + 2 tests
# (+ 26 s overhead each). RUN_TIMEOUT_CYCLE is its watchdog (run_matrix default 2400 s).
EST_RUN_S_CYCLE=730
RUN_TIMEOUT_CYCLE=2400
