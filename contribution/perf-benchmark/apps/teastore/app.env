# perfbench app bundle: TeaStore ribbon (thesis run results/TEASTORE-20260906).
# Plain KEY=value lines, safe to `source` from bash. tools/prepare.py reads this file too.
APP=teastore
APP_NS=teastore

# Journey A = browse locustfile (workloads/locustfile_A.py), locust 2.31.5, -u 8 -r 2.
STEADY_KIND=locust
STEADY_JOB=pb-steady
STEADY_IMAGE=locustio/locust:2.31.5
STEADY_LOCUSTFILE=/mnt/locustfile.py
STEADY_HOST=http://teastore-webui:8080
STEADY_USERS=8
STEADY_RATE=2

# Fixed-count test: product page, anonymous. webui -> auth (isloggedin), persistence
# (product, categories, recommended products), recommender, image. GET, no login, 200.
TP_JOB=pb-tp
TP_URL=http://teastore-webui:8080/tools.descartes.teastore.webui/product?id=7
TP_HEADERS=
TP_EXPECT_STATUS=200
TP_PRE_HOOK=

READY_TIMEOUT=900

# Harness budget (run_matrix.sh): RUN_TIMEOUT is the per-run watchdog in seconds for a full run;
# EST_RUN_S is the expected full-run time used for STATUS.json before the first run finishes.
RUN_TIMEOUT=5400
EST_RUN_S=2560

# Interleaved cycles (run_matrix.sh --cycles K, run_one.sh --profile cycle): one fixed-count test
# per mode of TP_N_CYCLE requests, sized for about 30-60 s a test at the measured c16 rate.
# Basis: no c16 run yet; smoke test at c8 (200 requests) 117.8 keep-alive / 139.0 new conn req/s, x0.7 for c16 = 82-97 req/s -> 5008 requests = 36-43 s at the smoke rates, 52-61 s at the assumed ones. Check after the first cycle.
# TP_N_CYCLE must be a multiple of TP_C (16): hey sends N/C requests per worker (5000 would send 4992).
# Precheck 2026-10-04 (play 6ac1c9b6, baseline, c16): 182.9 req/s -> 9152 (about 50 s).
TP_N_CYCLE=9152
# A cycle run: ~174 s switch/restart/misc + 60 s idle + 60 s warm-up + 300 s window + 2 tests
# (+ 26 s overhead each). RUN_TIMEOUT_CYCLE is its watchdog (run_matrix default 2400 s).
EST_RUN_S_CYCLE=790
RUN_TIMEOUT_CYCLE=2400
