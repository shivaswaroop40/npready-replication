# perfbench app bundle: Bank of Anthos v0.6.10 (thesis run results/BANK-20260904).
# Plain KEY=value lines, safe to `source` from bash. tools/prepare.py reads this file too.
APP=bank
APP_NS=bank

# Journey A = Google's AllTasks.UnauthenticatedTasks, verbatim (workloads/locustfile_A.py),
# shipped loadgenerator image entrypoint with USERS=5, LOG_LEVEL=info (spawn rate: locust default 1).
STEADY_KIND=locust
STEADY_JOB=pb-steady
STEADY_IMAGE=us-central1-docker.pkg.dev/bank-of-anthos-ci/bank-of-anthos/loadgenerator:v0.6.10@sha256:dd7e27f1b1bcbb9c85070eb900a6060d098d06d62ef03f98182424919895df83
STEADY_LOCUSTFILE=/app/locustfile.py
STEADY_HOST=http://frontend:80
STEADY_USERS=5
STEADY_RATE=1

# Fixed-count test: /home as the demo user. frontend fans out to balancereader,
# transactionhistory and contacts (each verifies the JWT; the first two read ledger-db
# through their caches, contacts reads accounts-db). Needs the session cookie:
# deploy.sh and restart.sh run session.sh, which logs in as the demo user (credentials
# read from ConfigMap demo-data-config at run time) and stores the cookie value in
# Secret perfbench-session (key "token"). throughput.yaml already injects the header below
# through Kubernetes $(VAR) expansion; the harness must not add it again.
# The token expires after TOKEN_EXPIRY_SECONDS=3600: TP_PRE_HOOK refreshes it.
TP_JOB=pb-tp
TP_URL=http://frontend:80/home
TP_HEADERS='Cookie: token=$(PB_SESSION_TOKEN)'
TP_EXPECT_STATUS=200
TP_PRE_HOOK=session.sh

READY_TIMEOUT=600

# Harness budget (run_matrix.sh): RUN_TIMEOUT is the per-run watchdog in seconds for a full run;
# EST_RUN_S is the expected full-run time used for STATUS.json before the first run finishes.
# /home serves about 11 req/s at c16 (three Java services capped at 500m; v2 validation: 902 s and
# 930 s per 10000-request test), so the 6 fixed-count tests take about 92 min and a full run about
# 2 h. PLAN.json runs bank as one play per rep.
# A 10000-request test at c16 took more than 900 s (the default per-test watchdog) in the v2
# validation, so the per-test watchdog is 2400 s and the run watchdog 3 h.
RUN_TIMEOUT=10800
EST_RUN_S=7260
TP_TIMEOUT_S=2400

# Interleaved cycles (run_matrix.sh --cycles K, run_one.sh --profile cycle): one fixed-count test
# per mode of TP_N_CYCLE requests, sized for about 30-60 s a test at the measured c16 rate.
# Basis: 10.8-12.2 req/s (v2 pilot, 10000 requests at c16) -> 608 requests = 50-56 s.
# TP_N_CYCLE must be a multiple of TP_C (16): hey sends N/C requests per worker (600 would send 592).
TP_N_CYCLE=608
# A cycle run: ~174 s switch/restart/misc + 60 s idle + 60 s warm-up + 300 s window + 2 tests
# (+ 26 s overhead each). RUN_TIMEOUT_CYCLE is its watchdog (run_matrix default 2400 s).
EST_RUN_S_CYCLE=800
RUN_TIMEOUT_CYCLE=3000
